<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>FS0025</WarningsAsErrors> <!-- incomplete matches are bugs -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Files are added here in App.fsproj compile order as each is implemented; -->
    <!-- see CLAUDE.md §2.2 for the full ordered file list. -->
    <Compile Include="Interop.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Storage.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Catalog.fs" />
    <Compile Include="Tei/Tokenizer.fs" />
    <Compile Include="Tei/Segmenter.fs" />
    <Compile Include="Tei/Aligner.fs" />
    <Compile Include="Zip.fs" />
    <Compile Include="Sources.fs" />
    <Compile Include="Router.fs" />
    <Compile Include="LibraryData.fs" />
    <Compile Include="WikiData.fs" />
    <Compile Include="Content.fs" />
    <Compile Include="Markdown.fs" />
    <Compile Include="GuideData.fs" />
    <Compile Include="LifeData.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="Features.fs" />
    <Compile Include="Search.fs" />
    <Compile Include="LearnData.fs" />
    <Compile Include="LearnFx.fs" />
    <Compile Include="LearnState.fs" />
    <Compile Include="Lenses/Greek.fs" />
    <Compile Include="Lenses/Prosody.fs" />
    <Compile Include="Lenses/Corpus.fs" />
    <Compile Include="Lenses/Places.fs" />
    <Compile Include="Lenses/Paleography.fs" />
    <Compile Include="Lenses/Widgets.fs" />
    <Compile Include="Views/Shared.fs" />
    <Compile Include="Views/SearchBox.fs" />
    <Compile Include="Views/Header.fs" />
    <Compile Include="Views/SettingsPane.fs" />
    <Compile Include="Views/Popover.fs" />
    <Compile Include="Views/Guide.fs" />
    <Compile Include="Views/Life.fs" />
    <Compile Include="Views/Learn.fs" />
    <Compile Include="Views/Study.fs" />
    <Compile Include="Views/Home.fs" />
    <Compile Include="Views/Lens.fs" />
    <Compile Include="Views/Reader.fs" />
    <Compile Include="Views/LibraryPage.fs" />
    <Compile Include="Views/WikiPages.fs" />
    <Compile Include="Views/About.fs" />
    <Compile Include="Views/Browse.fs" />
    <Compile Include="Views/NotesPanel.fs" />
    <Compile Include="Views/Forum.fs" />
    <Compile Include="Views/Account.fs" />
    <Compile Include="State.fs" />
    <Compile Include="Subscriptions.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.*" />
    <PackageReference Include="Fable.Browser.Blob" Version="1.*" />
    <PackageReference Include="Fable.Browser.Event" Version="1.*" />
    <PackageReference Include="Fable.Browser.WebStorage" Version="1.*" />
    <PackageReference Include="Fable.Promise" Version="3.*" />
    <PackageReference Include="Fable.Elmish" Version="4.*" />
    <PackageReference Include="Fable.Elmish.React" Version="4.*" />
    <PackageReference Include="Fable.Elmish.HMR" Version="7.*" />
    <PackageReference Include="Feliz" Version="3.3.3" />
    <PackageReference Include="Thoth.Json" Version="10.*" />
  </ItemGroup>
</Project>
